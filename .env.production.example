# Copia como .env.production EN EL VPS (nunca lo subas a GitHub):
#   cp .env.production.example .env.production && nano .env.production && chmod 600 .env.production
# El hash y el token se generan con:  docker compose -f compose.prod.yml run --rm --no-deps app node server/scripts/generar-clave.ts

# --- Acceso al panel ---
ADMIN_USUARIO=jair
ADMIN_CLAVE_HASH='CAMBIA_ESTO'
SESION_MINUTOS=30
LOGIN_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# --- Token compartido con el catálogo (en el catálogo va como METRICAS_TOKEN) ---
INGESTA_TOKEN=CAMBIA_ESTO

# --- Plan del VPS ---
# Hostinger KVM 2: revisa en hPanel el ancho de banda mensual y el día en que se reinicia
BANDA_LIMITE_GB=8000
BANDA_DIA_CORTE=1
# Interfaz de red pública. Vacío = se detecta sola (normalmente eth0 o ens3)
INTERFAZ_RED=

# --- Alertas por Telegram (opcional) ---
# 1) En Telegram habla con @BotFather -> /newbot -> te da el token
# 2) Mándale "hola" a tu bot y corre: docker compose -f compose.prod.yml run --rm --no-deps app node server/scripts/telegram-chat-id.ts
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
