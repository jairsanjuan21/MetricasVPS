# Desarrollo en tu PC. Copia este archivo como .env y llénalo con:  npm run clave
# (En Windows las métricas son simuladas porque no existe /proc; en el VPS son reales.)

ADMIN_USUARIO=admin
ADMIN_CLAVE_HASH='pega-aqui-el-hash-de-npm-run-clave'
INGESTA_TOKEN=pega-aqui-el-token-de-npm-run-clave

PUERTO=4000
SESION_MINUTOS=30
